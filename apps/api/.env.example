# Copy to apps/api/.env for local development. Everything is optional locally.

# Neon connection string. Leave unset to use the embedded Postgres in apps/api/.data.
# DATABASE_URL=postgres://...

# Public URL of the app. Leave unset locally: it's taken from each request, so the web dev
# server can run on any port. Set it in production.
# BETTER_AUTH_URL=
# Required in production: a long random string, e.g. `openssl rand -base64 32`.
# BETTER_AUTH_SECRET=

# Google sign-in (optional). Redirect URI: <site URL>/api/auth/callback/google
# (locally, the URL the web dev server prints, e.g. http://localhost:5173)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AI explanations (optional). Without a key the app uses template explanations.
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# FREE_EXPLANATIONS_PER_MONTH=30

# Local only: canned explanations with no API key or cost, to try the AI explanation flow.
# FAKE_LLM=1
