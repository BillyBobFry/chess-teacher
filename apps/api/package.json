{
  "name": "@chess-teacher/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:check": "drizzle-kit generate && test -z \"$(git status --porcelain -- drizzle)\" || (git status --short -- drizzle; echo \"schema.ts has changes with no migration: run pnpm --filter @chess-teacher/api db:generate and commit the result\"; exit 1)"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@chess-teacher/contract": "workspace:*",
    "@chess-teacher/core": "workspace:*",
    "@electric-sql/pglite": "0.6.0",
    "@hono/node-server": "2.1.11",
    "@hono/zod-validator": "0.9.1",
    "@neondatabase/serverless": "1.2.1",
    "better-auth": "1.7.27",
    "dotenv": "18.0.10",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.21",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@chess-teacher/engine": "workspace:*",
    "drizzle-kit": "0.31.11"
  }
}
