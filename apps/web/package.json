{
  "name": "@chess-teacher/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "stockfish": "node scripts/copy-stockfish.mjs",
    "dev": "node scripts/copy-stockfish.mjs && vite",
    "build": "node scripts/copy-stockfish.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm i18n && tsc --noEmit",
