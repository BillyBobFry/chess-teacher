    "react-aria-components": "1.22.1",
    "react-chessboard": "5.12.4",
    "react-dom": "19.3.1",
    "stockfish": "19.0.1",
    "stockfish11": "npm:stockfish@11.0.0",
    "tailwind-merge": "3.7.0",
