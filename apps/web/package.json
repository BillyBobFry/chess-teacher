    "i18n": "paraglide-js compile --project ./project.inlang --silent"
  },
  "dependencies": {
    "@chess-teacher/contract": "workspace:*",
    "@chess-teacher/core": "workspace:*",
    "@chess-teacher/engine": "workspace:*",
    "@inlang/paraglide-js-react": "1.0.4",
    "better-auth": "1.7.27",
    "chess.js": "1.4.0",
    "react": "19.3.1",
    "react-chessboard": "5.12.4",
    "react-dom": "19.3.1",
    "stockfish": "19.0.1",
    "stockfish11": "npm:stockfish@11.0.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "3.2.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "playwright": "1.65.0",
    "vite": "8.3.8"
  }
}
